function scr_init_globals(){
	
	// set up legacy scripts
	__init_background(); // set up background system
	__init_view(); // set up view system
	
	// set up variables
	global.audio_master = 0.35;
	global.onoffblock = 0;
	global.star_flash = 0;
	global.warp_x = 0;
	global.warp_y = 0;
	global.pp = 0;
	global.powerup = 0;
	
	
	
	
	
} 